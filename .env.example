# ═══════════════════════════════════════════════════════════════════════════════
# DE Decisions × Jev Roman Tribunal — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to '.env' and populate your OpenRouter API key:
#   cp .env.example .env     (Linux / macOS)
#   copy .env.example .env   (Windows CMD / PowerShell)
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] OpenRouter API Key
# Sign up and obtain an API key with credits from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# [OPTIONAL] AI Model Overrides
# Jev Decision Model (~typesafe/jev-latest is the System-1 structured decision engine)
JEV_MODEL=~typesafe/jev-latest

# Generative LLM for code remediation and technical reasoning
CHAT_MODEL=deepseek/deepseek-v4.1-flash

# [OPTIONAL] Server Configuration
PORT=8001
HOST=127.0.0.1
